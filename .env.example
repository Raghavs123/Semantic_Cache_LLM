# Copy to .env and edit.  (cp .env.example .env   |   Windows: copy .env.example .env)
# Every setting has a safe default; this file only lists the ones you are likely to change.

# --- cache -------------------------------------------------------------------------------
FAQ_THRESHOLD=0.83          # replace with the value `faqcache eval` picks for YOUR model
FAQ_TOP_K=3
FAQ_STORE=memory            # memory | faiss  (faiss needs: pip install -e ".[faiss]")
FAQ_SEED_VARIANTS=true      # also cache the extra phrasings in data/faqs.json
FAQ_NEGATION_GUARD=true
FAQ_VOLATILE_TTL_DAYS=7     # price / fee / policy answers expire after 7 days

# --- embeddings --------------------------------------------------------------------------
FAQ_EMBEDDER=sentence-transformers   # or "hash" (offline toy, tests only)
FAQ_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# lighter (re-run `faqcache eval` after switching: the best threshold differs per model):
# FAQ_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- LLM used on a cache miss --------------------------------------------------------------
# fake = offline stand-in (no key, simulated latency). Real options below.
FAQ_LLM_PROVIDER=fake
FAQ_FAKE_LLM_LATENCY_MS=800

# Anthropic (pip install -e ".[anthropic]")
# FAQ_LLM_PROVIDER=anthropic
# FAQ_LLM_MODEL=claude-opus-5-5        # or claude-sonnet-5-5 / claude-haiku-5-5 (cheaper)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (pip install -e ".[openai]")
# FAQ_LLM_PROVIDER=openai
# FAQ_LLM_MODEL=<a current OpenAI model id>
# OPENAI_API_KEY=sk-...

# Google Gemini (pip install -e ".[gemini]")
# FAQ_LLM_PROVIDER=gemini
# FAQ_LLM_MODEL=<a current Gemini model id>
# GEMINI_API_KEY=...

# Ollama, free and local (pip install -e ".[ollama]";  ollama pull llama3.2)
# FAQ_LLM_PROVIDER=ollama
# FAQ_LLM_MODEL=llama3.2
# FAQ_OLLAMA_HOST=http://localhost:11434
